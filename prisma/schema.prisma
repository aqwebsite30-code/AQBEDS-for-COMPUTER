generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String?
  price       Float
  salePrice   Float?
  category    String
  stock       Int              @default(0)
  sku         String?          @unique
  rating      Float            @default(0)
  featured    Boolean          @default(false)
  options     String?          // JSON: fabrics, colors, sizes, mattress, headboard, storage options
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  images      ProductImage[]
  variants    ProductVariant[]
}

model ProductVariant {
  id            String  @id @default(uuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String?
  color         String?
  fabric        String?
  mattress      String?
  frame         String?
  headboard     String?
  storage       String?
  priceModifier Float   @default(0)
  stock         Int     @default(0)
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  alt       String?
  sortOrder Int     @default(0)
}

model Order {
  id              String        @id @default(uuid())
  customerName    String
  customerEmail   String
  customerPhone   String
  customerAddress String
  items           String        // JSON string of cart items
  instructions    String?
  status          String        @default("pending")
  total           Float
  salespersonId   String?
  salesperson     Salesperson?  @relation(fields: [salespersonId], references: [id])
  trackingToken   String?
  createdAt       DateTime      @default(now())
}

model Salesperson {
  id           String      @id @default(uuid())
  fullName     String
  email        String?
  phone        String?
  employeeCode String      @unique
  status       String      @default("active")
  token        String      @unique
  createdAt    DateTime    @default(now())
  orders       Order[]
  visits       SiteVisit[]
}

model SiteVisit {
  id             String       @id @default(uuid())
  salespersonId  String
  salesperson    Salesperson  @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  token          String
  pageUrl        String?
  referrer       String?
  userAgent      String?
  createdAt      DateTime     @default(now())
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}
model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String   // Anonymous session ID
  content   String
  isUser    Boolean  @default(true) // true if from customer, false if from admin
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Own analytics funnel events (PageView / ViewContent / AddToCart /
// InitiateCheckout / Purchase). Completely separate from the Meta Pixel + CAPI
// pipeline — stored only for the /admin/analytics dashboard. Kept forever.
model AnalyticsEvent {
  id          String   @id @default(uuid())
  visitorId   String
  sessionId   String
  event       String
  path        String?
  referrer    String?
  productId   String?
  productName String?
  value       Float?
  currency    String   @default("GBP")
  device      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([event, createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId])
  @@index([productId])
}
