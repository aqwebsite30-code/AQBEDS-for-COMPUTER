{
  "name": "aqbeds",
  "buildCommand": "npm run build",
  "framework": null,
  "installCommand": "npm install",
  "outputDirectory": "dist/client",
  "functions": {
    "api/ai-chat.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/meta-capi",
      "dest": "/api/meta-capi.js"
    },
    {
      "src": "/api/meta-catalog.csv",
      "dest": "/api/meta-catalog.js"
    },
    {
      "src": "/api/ai-chat",
      "dest": "/api/ai-chat.js"
    },
    {
      "src": "/",
      "dest": "/api/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ]
}
